# Copy this file to .env and fill in the values before running `docker compose up`.

# The only secret the task requires — generation falls back to a deterministic offline mock
# (see LLM_MOCK below) if this is left blank, so the app still runs end-to-end without it.
ANTHROPIC_API_KEY=

# Used to sign session cookies — any random string of 16+ characters. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-this-to-a-random-32-byte-string

# Set to "true" to skip real Anthropic calls and use a deterministic offline mock instead
# (useful for trying the app without a key, or in CI). Leave unset/false to use the real API.
LLM_MOCK=false
